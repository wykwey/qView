set(CPACK_GENERATOR "DEB")
set(CPACK_PACKAGE_NAME "qview")
set(CPACK_PACKAGE_VENDOR "qView")
set(CPACK_PACKAGE_CONTACT "jurplel <jurplel@interversehq.com>")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Practical and minimal image viewer")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://interversehq.com/qview/")
set(CPACK_RESOURCE_FILE_LICENSE "${CMAKE_SOURCE_DIR}/LICENSE")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_DEBIAN_FILE_NAME "DEB-DEFAULT")
set(CPACK_DEBIAN_PACKAGE_SECTION "graphics")
set(CPACK_DEBIAN_PACKAGE_PRIORITY "optional")
set(CPACK_DEBIAN_PACKAGE_RELEASE "1" CACHE STRING "Debian package revision")
# Derive library dependencies from the installed executable using dpkg-shlibdeps.
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
if(QT_VERSION_MAJOR EQUAL 5)
    set(CPACK_DEBIAN_PACKAGE_DEPENDS "libqt5svg5")
    set(CPACK_DEBIAN_PACKAGE_RECOMMENDS
        "qt5-image-formats-plugins, adwaita-icon-theme")
else()
    set(CPACK_DEBIAN_PACKAGE_DEPENDS "libqt6svg6")
    set(CPACK_DEBIAN_PACKAGE_RECOMMENDS
        "qt6-image-formats-plugins, adwaita-icon-theme")
endif()
include(CPack)
