<RCC>
    <qresource prefix="/fonts">
        <file>Lato-Light.ttf</file>
        <file>Lato-Regular.ttf</file>
        <file>MaterialIconsOutlined-Regular.otf</file>
    </qresource>
    <qresource prefix="/images">
        <file>checkmark.png</file>
    </qresource>
    <qresource prefix="/toolbar">
        <file alias="previousfile.svg">toolbar/previousfile.svg</file>
        <file alias="nextfile.svg">toolbar/nextfile.svg</file>
        <file alias="zoomin.svg">toolbar/zoomin.svg</file>
        <file alias="zoomout.svg">toolbar/zoomout.svg</file>
        <file alias="rotateright.svg">toolbar/rotateright.svg</file>
    </qresource>
</RCC>
